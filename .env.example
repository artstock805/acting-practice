# 로컬 실행용 키 견본. 이 파일을 .env로 복사해 값을 채운 뒤 `npm run dev` (.env는 git·Cloud Build에 올라가지 않음)

# Claude (배역 분석·초목표 분석·장면 그림 설명)
ANTHROPIC_API_KEY=

# Langfuse: cloud.langfuse.com → 프로젝트 → Settings → API Keys 에서 발급
# 두 키가 모두 있을 때만 Claude 호출이 Langfuse에 기록됨
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 프로젝트를 만든 지역: EU면 비워 둠, US면 https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=
# Langfuse 화면에서 기록을 나눠 볼 이름 (비우면 local)
LANGFUSE_TRACING_ENVIRONMENT=local
