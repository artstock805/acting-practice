server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    charset utf-8;
    charset_types text/css application/javascript application/manifest+json;

    gzip on;
    gzip_types text/css application/javascript application/manifest+json image/svg+xml;

    # 마이크는 이 사이트에서만 쓰고, 카메라·위치는 막음
    add_header Permissions-Policy "microphone=(self), camera=(), geolocation=()" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # 코드 파일은 매번 새로 확인해 수정 사항이 바로 반영되게 함 (serve.ps1과 같은 방식)
    location ~* \.(html|js|css|webmanifest)$ {
        # nginx 기본 MIME 목록에 없는 .webmanifest만 따로 지정 (types를 서버 전체에 두면 기본 목록이 통째로 덮어써짐)
        location ~* \.webmanifest$ {
            types { }
            default_type application/manifest+json;
            add_header Cache-Control "no-cache";
            add_header Permissions-Policy "microphone=(self), camera=(), geolocation=()" always;
            add_header X-Content-Type-Options nosniff always;
            add_header Referrer-Policy strict-origin-when-cross-origin always;
        }
        add_header Cache-Control "no-cache";
        add_header Permissions-Policy "microphone=(self), camera=(), geolocation=()" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
